# Database connection
DATABASE_URL=postgresql://memorybook:CHANGE_ME@localhost:5432/memorybook

# Redis (optional - for future caching integration)
REDIS_URL=redis://localhost:6379/0

# Storage paths
UPLOAD_DIR=./storage/images
THUMBNAIL_DIR=./storage/thumbnails
MAX_UPLOAD_SIZE=52428800

# OCR configuration
TESSERACT_CMD=
OCR_LANGUAGES=eng

# API settings
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:8088,http://localhost:5173,http://localhost:3000

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM=HS256
